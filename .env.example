# ClashMate Environment Configuration

# Backend
PROJECT_NAME="ClashMate"
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="postgresql+psycopg2://clashmate:clashmate_secret_password@localhost:5432/clashmate_db"
# For zero-config local development without Postgres:
# DATABASE_URL="sqlite:///./clashmate.db"

# Background Tasks & Redis
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Optional AI LLM Integrations
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
